-- Shared pgTAP helpers, included by each test file with `\ir _helpers.psql`.
-- Created inside the test's transaction, so they vanish on rollback.
-- (Not a .sql file, so the test runner does not run it as a test.)

create extension if not exists pgtap with schema extensions;

create schema if not exists tests;
grant usage on schema tests to anon, authenticated, service_role;

-- A confirmed auth user.
create or replace function tests.create_user(p_email text) returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    instance_id, id, aud, role, email, raw_app_meta_data, raw_user_meta_data,
    email_confirmed_at, created_at, updated_at
  ) values (
    '00000000-0000-0000-0000-000000000000', v_id, 'authenticated',
    'authenticated', p_email, '{"provider":"email","providers":["email"]}',
    jsonb_build_object('full_name', split_part(p_email, '@', 1)),
    now(), now(), now()
  );
  return v_id;
end;
$$;

-- Act as a signed-in user for the rest of the transaction (or until the next
-- tests.as_* call). p_aal is the session's assurance level (2FA = 'aal2').
create or replace function tests.as_user(p_email text, p_aal text default 'aal1')
returns void
language plpgsql
as $$
declare
  v_id uuid;
begin
  reset role;
  select id into v_id from auth.users where email = p_email;
  if v_id is null then
    raise exception 'tests.as_user: no user %', p_email;
  end if;
  perform set_config('request.headers', '{}', true);
  perform set_config(
    'request.jwt.claims',
    jsonb_build_object(
      'sub', v_id, 'email', p_email, 'role', 'authenticated', 'aal', p_aal
    )::text,
    true
  );
  perform set_config('role', 'authenticated', true);
end;
$$;

-- Act as an API-key caller (anon role + api-key header).
create or replace function tests.as_api_key(p_key text) returns void
language plpgsql
as $$
begin
  reset role;
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('request.headers', jsonb_build_object('api-key', p_key)::text, true);
  perform set_config('role', 'anon', true);
end;
$$;

create or replace function tests.as_service() returns void
language plpgsql
as $$
begin
  reset role;
  perform set_config('request.headers', '{}', true);
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
  perform set_config('role', 'service_role', true);
end;
$$;

-- Back to the superuser test runner, no JWT.
create or replace function tests.as_postgres() returns void
language plpgsql
as $$
begin
  reset role;
  perform set_config('request.headers', '{}', true);
  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- An organization created through the API by p_owner_email, exactly like
-- the UI does (so every trigger runs). Returns its id.
create or replace function tests.create_org(p_owner_email text, p_name text)
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  perform tests.as_user(p_owner_email);
  insert into public.organizations (id, name) values (v_id, p_name);
  perform tests.as_postgres();
  return v_id;
end;
$$;

-- Adds an existing user to an organization with a crm role, bypassing the
-- invitation flow (that flow has its own tests).
create or replace function tests.add_member(
  p_org uuid,
  p_email text,
  p_role_key text
) returns uuid
language plpgsql
as $$
declare
  v_agent uuid;
  v_role crm.roles;
begin
  perform tests.as_postgres();
  select * into v_role from crm.roles
  where organization_id = p_org and key = p_role_key;

  insert into public.agents (organization_id, user_id, name, role)
  select p_org, u.id, split_part(p_email, '@', 1), v_role.tier
  from auth.users u where u.email = p_email
  returning id into v_agent;

  update crm.member_roles set role_id = v_role.id where agent_id = v_agent;
  return v_agent;
end;
$$;

create or replace function tests.agent_id(p_org uuid, p_email text) returns uuid
language sql
security definer
as $$
  select a.id from public.agents a join auth.users u on u.id = a.user_id
  where a.organization_id = p_org and u.email = p_email;
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;
