# Embedded Signup credential exchange. Before Meta Business Verification
# clears (or any time you don't have real values yet), set META_APP_ID=mock
# (META_APP_SECRET can be anything -- it's never checked in mock mode) to
# exercise the full signup flow against canned responses instead of
# graph.facebook.com. See whatsapp-management/embedded_signup.ts.
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_ID=
# Shared token used when a connected number has no per-row token of its own
# (crm.get_whatsapp_access_token falls back to this). Point it at a real
# Cloud API test number's token (App Dashboard > WhatsApp > API Setup -- no
# Business Verification needed) for real inbound webhook / outbound smoke
# tests without a completed Embedded Signup. See README.md "WhatsApp
# integration > Local development before Business Verification clears".
META_SYSTEM_USER_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
# Self-hosted whatsmeow bridge (open-bsp-whatsmeow), 'whatsapp-web' service.
# Base URL of the bridge and the shared bearer token used in both directions.
# Connector services follow the <SERVICE>_URL / <SERVICE>_TOKEN convention
# (see generic-webhook / generic-dispatcher).
WHATSAPP_WEB_URL=
WHATSAPP_WEB_TOKEN=